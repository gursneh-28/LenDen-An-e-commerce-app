{
  "expo": {
    "name": "LenDen-An-e-commerce-app",
    "slug": "LenDen-An-e-commerce-app",
    "scheme": "lenden",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#028090"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.gursneh.LenDenAnecommerceapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8b2d9b8a-38fd-47e9-9f19-cd9d58dc1dce"
      }
    }
  }
}
